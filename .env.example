NEWS_API_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_key_here
FINNHUB_API_KEY=your_finnhub_key_here
FETCH_INTERVAL_HOURS=2
DB_PATH=data/sentiment_data.db

# optional — enables FinBERT deep NLP scoring
USE_FINBERT=false

# optional LLM keys for the RAG insight engine
OPENAI_API_KEY=your_openai_key_here
HUGGINGFACE_API_KEY=your_hf_key_here

# MLOps — Weights & Biases experiment tracking
# leave blank to run in offline mode (still tracks locally)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=young-investor-trust
WANDB_ENTITY=

# vector store
CHROMA_PERSIST_DIR=data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# Triton Inference Server (optional — falls back to local HuggingFace inference)
TRITON_URL=localhost:8000
TRITON_MODEL_NAME=finbert
USE_TRITON=false

# fine-tuned model (set after running: python sentiment/finbert_finetune.py)
FINETUNED_MODEL_PATH=models/finbert-finetuned
MODEL_REGISTRY_PATH=data/model_registry.json
USE_FINBERT=false
